---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import Arrow from '../../components/Arrow.astro';
import { eduPrograms } from '../../data/education';
import type { EduProgram } from '../../data/education';
import { site } from '../../data/site';
export function getStaticPaths() { return eduPrograms.map((program) => ({ params: { slug: program.slug }, props: { program } })); }
interface Props { program: EduProgram; }
const { program } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'Course', name: program.name, description: program.lead, inLanguage: 'pl', audience: { '@type': 'EducationalAudience', educationalRole: 'teacher' }, provider: { '@type': 'Organization', name: 'vs76project', ...(site.url ? { url: site.url } : {}) } };
---
<Layout title={program.name} seoTitle={`${program.short}, szkolenie dla szkół`} description={program.lead} schema={schema}>
 <div class="container page-head">
  <a class="text-link" href="/edukacja/">Wszystkie programy dla szkół</a>
  <h1 style="font-size:clamp(2.2rem,4.8vw,4.4rem);max-width:23ch;margin-top:1.5rem">{program.name}</h1>
  <p class="lead">{program.lead}</p>
 </div>
 <div class="container course-grid">
  <div>
   <section class="content-block"><h2>Dla kogo?</h2><p>{program.audience}</p><h3>Forma</h3><p>{program.format}</p><h3>Organizacja</h3><p>{program.requirements}</p></section>
   <section class="content-block"><h2>Cele szkolenia</h2><ul>{program.goals.map((g) => <li><strong>{g.who}:</strong> {g.text}</li>)}</ul></section>
   <section class="content-block">
    <h2>Program</h2>
    <ol class="module-list">
     {program.modules.map((m) => (
      <li>
       <h3>Moduł {m.n}: {m.title}</h3>
       <p class="module-meta"><span class="tag">{m.hours}</span><span class="tag">{m.who}</span></p>
       <ul>{m.points.map((pt) => <li>{pt.text}{pt.sub && <ul>{pt.sub.map((s) => <li>{s}</li>)}</ul>}</li>)}</ul>
      </li>
     ))}
    </ol>
   </section>
   <section class="content-block"><h2>Co zyskuje szkoła</h2><ul>{program.benefits.map((b) => <li><strong>{b.title}.</strong> {b.text}</li>)}</ul></section>
   <section class="content-block"><h2>Granice szkolenia</h2><p>{program.boundary}</p></section>
  </div>
  <aside class="course-sidebar" aria-label="Warunki szkolenia">
   <p class="price">Wycena indywidualna</p>
   <p class="fine-print">Cena zależy od liczby uczestników, formy i miejsca. Przygotowujemy ofertę po rozpoznaniu potrzeb szkoły.</p>
   <dl class="course-facts">
    <div><dt>Czas</dt><dd>{program.duration}</dd></div>
    <div><dt>Podział</dt><dd>{program.schedule}</dd></div>
    <div><dt>Miejsce</dt><dd>Stacjonarnie lub online</dd></div>
    <div><dt>Odbiorcy</dt><dd>Dyrekcja i nauczyciele</dd></div>
   </dl>
   <a class="button" href={`/kontakt/?temat=${encodeURIComponent(program.short)}`}>Zapytaj o szkolenie<Arrow /></a>
  </aside>
 </div>
 <CTA />
</Layout>
