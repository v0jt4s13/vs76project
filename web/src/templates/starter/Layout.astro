---
// Szablon "starter": jasny, szeroki układ z dużym zdjęciem. Projekt: materials/website-design-projekt/vs76project-starter.
import './styles.css';
import Head from '../_shared/Head.astro';
import Brand from './Brand.astro';
import { site, navigation } from '../../data/site';
interface Props { title: string; seoTitle?: string; description?: string; schema?: Record<string,unknown>; }
const path = Astro.url.pathname;
const links = [...navigation, ['/kontakt/', 'Kontakt'], ...(import.meta.env.DEV && import.meta.env.PUBLIC_REVIEW_ENABLED ? [['/odbior/', 'Odbiór projektu']] : [])];
const templatePorts = (import.meta.env.PUBLIC_TEMPLATE_PORTS || '').split(',').map((entry) => { const [name, port] = entry.split(':'); return { name, port }; }).filter(({ name, port }) => name && /^\d+$/.test(port || ''));
---
<!doctype html>
<html lang="pl" data-template="starter">
<head>
<Head {...Astro.props} themeColor="#062330" />
</head>
<body>
<a href="#tresc" class="skip-link">Przejdź do treści</a>
<header class="site-header">
 <div class="header-inner container">
  <Brand />
  <nav id="navigation" class="navigation" aria-label="Główna">{links.map(([href,label])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}
  <div class="nav-preferences">
   <button class="theme-toggle" type="button" data-theme-toggle data-theme-icon hidden aria-label="Zmień motyw">
    <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
    <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14a8 8 0 0 1-10-10 8.5 8.5 0 1 0 10 10Z"/></svg>
   </button>
   <label class="font-control"><span class="sr-only">Krój pisma</span><select data-font-select aria-label="Wybierz krój pisma"><option value="noto">Noto Sans</option><option value="ibm-plex">IBM Plex Sans</option><option value="atkinson">Atkinson Hyperlegible</option><option value="literata">Literata</option></select></label>
  </div>
  </nav>
  <div class="header-controls">
   {import.meta.env.DEV && templatePorts.length > 1 && <label class="template-control"><span class="sr-only">Szablon strony</span><select data-template-switch aria-label="Przełącz szablon">{templatePorts.map(({ name, port }) => <option value={port} selected={name === site.template}>{name === 'classic' ? 'Classic' : name === 'starter' ? 'Starter' : name}</option>)}</select></label>}
   <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation" aria-label="Otwórz menu"><span></span><span></span><span></span></button>
  </div>
 </div>
</header>
<main id="tresc" tabindex="-1"><slot /></main>
<footer class="site-footer"><div class="container footer-inner">
 <div class="footer-top"><Brand footer /><p>Wiedza. Praktyka. Kontrola.</p><a href="#tresc">Wróć na górę ↑</a></div>
 <nav class="footer-links" aria-label="Stopka"><a href="/o-nas/">O vs76project</a><a href="/szkolenia/">Szkolenia AI</a><a href="/edukacja/">AI w edukacji</a><a href="/doradztwo/">Doradztwo</a><a href="/ai-security/">AI Security</a><a href="/wiedza/">Wiedza</a><a href="/bannery/">Próbki bannerów</a><a href="/wspolpraca/">Współpraca B2B</a><a href="/kontakt/">Kontakt</a><a href="/prywatnosc/">Prywatność</a></nav>
 <p class="footer-note">© {new Date().getFullYear()} vs76project.pl Szkolenia i doradztwo AI dla firm.</p>
</div></footer>
<script>import '../../scripts/site';import '../../scripts/motion';import './menu';</script>
</body>
</html>
